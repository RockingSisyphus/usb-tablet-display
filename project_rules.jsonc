{
  "rule_params": {
    "vibeflow.project.layout": {
      "directories": [
        {
          "path": "kernel",
          "purpose": "Bundled VibeFlow runtime and user documentation"
        },
        {
          "path": "cli",
          "purpose": "Command line entry point"
        },
        {
          "path": "bin",
          "purpose": "Launch wrappers"
        },
        {
          "path": "services",
          "purpose": "Systemd unit definitions"
        },
        {
          "path": "tools",
          "purpose": "Offline verification scripts"
        },
        {
          "path": "vendor",
          "purpose": "Vendored third-party runtime payloads"
        },
        {
          "path": "gnome-shell-ext",
          "purpose": "GNOME Shell extension source installed with the stack"
        },
        {
          "path": "install",
          "purpose": "Install templates copied into the user configuration"
        },
        {
          "path": ".pytest_cache",
          "purpose": "Pytest cache directory"
        },
        {
          "path": "vibeflow-preview",
          "purpose": "Offline workflow viewer assets and history"
        },
        {
          "path": "usb_tablet_display/nodeset_types",
          "purpose": "Reusable workflow subgraphs shared by the daemon and one-shot entries"
        },
        {
          "path": "usb_tablet_display/probes",
          "purpose": "Workflow execution inputs for verification runs"
        },
        {
          "path": "nodes",
          "purpose": "多个 root 共用的业务节点"
        },
        {
          "path": "usb_tablet_maintenance",
          "purpose": "维护类 root（只读检查与安装）"
        },
        {
          "path": "archive",
          "purpose": "旧项目归档压缩包"
        },
        {
          "path": "gui",
          "purpose": "GTK 控制面板源码"
        },
        {
          "path": "desktop",
          "purpose": "桌面入口模板"
        }
      ]
    }
  }
}
