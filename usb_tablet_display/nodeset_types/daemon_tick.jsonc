{
  "type_key": "usb.daemon_tick",
  "display_name": "Daemon tick",
  "description": "One iteration of the long-running controller loop.",
  "requires": [],
  "provides": [],
  "pipeline": {
    "inputs": [],
    "nodes": [
      {"id": "start", "definition_id": "usb.start", "display_name": "Begin tick", "description": "Begins one controller iteration."},
      {"id": "tick", "definition_id": "usb.tick_step", "display_name": "Advance tick", "description": "Waits, updates and publishes the runtime state, then reports whether to stop."},
      {"id": "end", "definition_id": "usb.end", "display_name": "Finish tick", "description": "Finishes one controller iteration."}
    ],
    "edges": [["start", "tick"], ["tick", "end"]],
    "outputs": [
      {"type": "usb.shutdown", "cardinality": "exactly_one", "display_name": "Stop flag"}
    ]
  }
}
