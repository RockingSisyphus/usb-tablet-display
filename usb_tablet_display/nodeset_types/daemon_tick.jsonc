{
  "type_key": "usb.daemon_tick",
  "display_name": "常驻程序的一轮",
  "description": "常驻程序每一轮要做的事：收集信息、判断当前状态，必要时执行一次连接或断开。",
  "requires": [],
  "provides": [],
  "pipeline": {
    "inputs": [],
    "nodes": [
      {
        "id": "start",
        "definition_id": "usb.start",
        "display_name": "开始",
        "description": "表示这个流程从这里开始，本身不做任何事。"
      },
      {
        "id": "io",
        "definition_id": "usb.state_io",
        "display_name": "读取设置与状态",
        "description": "一次性读取设置和上次保存的运行状态。"
      },
      {
        "id": "probe",
        "definition_id": "usb.device_probe",
        "display_name": "检查平板状态",
        "description": "确认平板与调试连接是否可用。"
      },
      {
        "id": "sstatus",
        "definition_id": "usb.session_status",
        "display_name": "检查是否正在投屏",
        "description": "判断平板是否真的在显示电脑画面。"
      },
      {
        "id": "poll",
        "definition_id": "usb.poll_session",
        "display_name": "查看会话结果",
        "description": "查看后台连接或断开是否已经结束。"
      },
      {
        "id": "inet",
        "definition_id": "usb.internet_tick",
        "display_name": "定期检查网络",
        "description": "按间隔检查平板网络。"
      },
      {
        "id": "request",
        "definition_id": "usb.take_request",
        "display_name": "处理用户命令",
        "description": "领取一条用户命令。"
      },
      {
        "id": "decide",
        "definition_id": "usb.decide_action",
        "display_name": "决定要做什么",
        "description": "决定连接、断开或什么都不做。"
      },
      {
        "id": "connect",
        "definition_id": "usb.call_connect",
        "display_name": "发起连接",
        "description": "需要连接时在后台启动连接工作流。"
      },
      {
        "id": "disconnect",
        "definition_id": "usb.call_disconnect",
        "display_name": "发起断开",
        "description": "需要断开时在后台启动断开工作流。"
      },
      {
        "id": "tick",
        "definition_id": "usb.tick_merge",
        "display_name": "推进一轮循环",
        "description": "写入本轮状态并判断是否停止。"
      },
      {
        "id": "end",
        "definition_id": "usb.end",
        "display_name": "结束",
        "description": "表示这个流程到此结束，本身不做任何事。"
      }
    ],
    "edges": [
      [
        "start",
        "io"
      ],
      [
        "start",
        "request"
      ],
      [
        "io",
        "probe"
      ],
      [
        "io",
        "sstatus"
      ],
      [
        "io",
        "poll"
      ],
      [
        "io",
        "inet"
      ],
      [
        "io",
        "decide"
      ],
      [
        "io",
        "connect"
      ],
      [
        "io",
        "disconnect"
      ],
      [
        "io",
        "tick"
      ],
      [
        "probe",
        "sstatus"
      ],
      [
        "probe",
        "decide"
      ],
      [
        "probe",
        "tick"
      ],
      [
        "sstatus",
        "decide"
      ],
      [
        "poll",
        "decide"
      ],
      [
        "poll",
        "tick"
      ],
      [
        "request",
        "decide"
      ],
      [
        "decide",
        "connect"
      ],
      [
        "decide",
        "disconnect"
      ],
      [
        "decide",
        "tick"
      ],
      [
        "connect",
        "tick"
      ],
      [
        "disconnect",
        "tick"
      ],
      [
        "inet",
        "tick"
      ],
      [
        "tick",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "usb.shutdown",
        "cardinality": "exactly_one",
        "display_name": "Stop flag"
      }
    ],
    "entry_mode": "async"
  }
}
