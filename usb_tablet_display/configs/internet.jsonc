{
  "pipeline": {
    "inputs": [],
    "nodes": [
      {
        "id": "start",
        "definition_id": "usb.start",
        "display_name": "开始",
        "description": "表示这个流程从这里开始，本身不做任何事。"
      },
      {
        "id": "io",
        "definition_id": "usb.state_io",
        "display_name": "读取设置与状态",
        "description": "一次性读取用户设置和上次保存的运行状态，供后续步骤共同使用。"
      },
      {
        "id": "probe",
        "definition_id": "usb.device_probe",
        "display_name": "检查平板状态",
        "description": "确认平板是否插着、调试连接是否正常，并找到它对应的网络接口。"
      },
      {
        "id": "sync",
        "definition_id": "usb.internet_sync",
        "display_name": "同步平板网络",
        "description": "确保平板能通过 USB 共享电脑的网络，并实际测试平板是否真的能上网。"
      },
      {
        "id": "end",
        "definition_id": "usb.end",
        "display_name": "结束",
        "description": "表示这个流程到此结束，本身不做任何事。"
      }
    ],
    "edges": [
      [
        "start",
        "io"
      ],
      [
        "io",
        "probe"
      ],
      [
        "probe",
        "sync"
      ],
      [
        "io",
        "sync"
      ],
      [
        "sync",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "usb.internet_state",
        "cardinality": "exactly_one",
        "display_name": "Internet state"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "../nodeset_types/state_io.jsonc"
    },
    {
      "path": "../nodeset_types/device_probe.jsonc"
    }
  ],
  "plugins": []
}
