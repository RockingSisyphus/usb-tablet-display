      "node:usb.tick_merge": {
        "kind": "node",
        "node_type": "vibeflow.node",
        "id": "usb.tick_merge",
        "display_name": "Advance tick",
        "description": "Waits one tick interval, merges probe results into the runtime state and publishes it.",
        "version": "0.1.0",
        "flow_kind": "process",
        "tags": [],
        "external": false,
        "contract": {
          "requires": [
            {
              "type": "usb.state",
              "cardinality": "exactly_one",
              "display_name": "Runtime state"
            },
            {
              "type": "usb.settings",
              "cardinality": "exactly_one",
              "display_name": "Tablet settings"
            },
            {
              "type": "usb.device",
              "cardinality": "exactly_one",
              "display_name": "USB device"
            },
            {
              "type": "usb.adb_state",
              "cardinality": "exactly_one",
              "display_name": "ADB transport state"
            }
          ],
          "provides": [
            {
              "key": "stop",
              "type": "usb.shutdown",
              "display_name": "Stop flag"
            }
          ],
          "input_semantics": {
            "usb.state": [
              "State carried from the previous iteration."
            ],
            "usb.settings": [
              "Configuration for the current run."
            ],
            "usb.device": [
              "USB presence and RNDIS interface from this iteration."
            ],
            "usb.adb_state": [
              "ADB transport state from this iteration."
            ]
          },
          "output_semantics": {
            "stop": [
              "True when the daemon should leave its loop."
            ]
          },
          "params_schema": {
            "state_path": {
              "type": "string"
            },
            "shutdown_path": {
              "type": "string"
            },
            "tick_ms": {
              "type": "integer"
            },
            "max_ticks": {
              "type": "integer"
            }
          },
          "params_defaults": {
            "state_path": "/tmp/usb-tablet-display/state.json",
            "shutdown_path": "/tmp/usb-tablet-display/shutdown",
            "tick_ms": 200,
            "max_ticks": 0
          },
          "examples": []
        },
