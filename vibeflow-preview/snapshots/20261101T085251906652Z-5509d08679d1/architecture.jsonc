            "ADB transport state from this iteration."
          ],
          "usb.device": [
            "USB presence and RNDIS interface from this iteration."
          ],
          "usb.settings": [
            "Configuration for the current run."
          ],
          "usb.state": [
            "State carried from the previous iteration."
          ]
        },
