[Unit]
Description=USB tablet reverse tethering (VibeFlow)
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 cli/vpn.py
ExecStop=/usr/bin/python3 cli/vpn.py stop
TimeoutStopSec=6
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
